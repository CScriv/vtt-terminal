{{!--
  datapad-create.hbs — new datapad form (GM only). Creates the journal,
  its flags, and a starter payload. The datapad is created UNDISCOVERED,
  so a half-built one is never visible to players.
--}}
<div class="{{themeClass}} compose-wrap">
  <form class="compose-form" onsubmit="return false;">

    <div class="form-group">
      <label>Title</label>
      <input type="text" name="title" placeholder="Cerberus Operations Log" autofocus />
    </div>

    <div class="form-group">
      <label>Id</label>
      <input type="text" name="id" placeholder="derived from the title" />
      <p class="compose-hint">The navigation address: <code>datapads/&lt;id&gt;</code>. Must be unique.</p>
    </div>

    <div class="form-group">
      <label>Source</label>
      <input type="text" name="source" placeholder="where it was recovered from" />
    </div>

    <div class="form-group">
      <label>Recovered</label>
      <input type="text" name="date" placeholder="28 Oct 2186" />
    </div>

    <div class="form-group">
      <label>Tag</label>
      <input type="text" name="tag" placeholder="SASO" />
    </div>

    <div class="form-group">
      <label>Prompt</label>
      <input type="text" name="prompt" placeholder="DECRYPTING ARCHIVE" />
    </div>

    <p class="compose-hint">
      Created hidden. Add blocks on the datapad screen, then mark it discovered when the crew finds it.
    </p>

    <div class="compose-actions">
      <button type="button" data-action="save">Create datapad</button>
    </div>

  </form>
</div>
