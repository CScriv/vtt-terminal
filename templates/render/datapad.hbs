{{!--
  render/datapad.hbs — a single datapad, rendered from typed blocks.
  Block types: heading, text, keyvalue, table, message.
  Secret blocks: players only see them once revealed (filtered in JS).
  GM sees all; secret blocks show a DECRYPTED/ENCRYPTED marker + a
  reveal toggle.

  AUTHORING (GM only): a control bar for the header fields, the
  discovery state and adding blocks; per-block edit / move / delete
  controls sit in the same bar as the reveal toggle. Players see none
  of it — the whole surface is gated on datapad.canEdit.
--}}
{{#if screen.prompt}}
  <p class="term-prompt">&gt; {{screen.prompt}}</p>
{{/if}}

{{#if datapad.canEdit}}
  <div class="dp-edit-bar">
    <span class="dp-edit-btn" data-action="editDatapadMeta" data-member-id="{{datapad.memberId}}">[ edit info ]</span>
    <span class="dp-edit-btn" data-action="addBlock" data-member-id="{{datapad.memberId}}">[ + add block ]</span>
    <span class="dp-discover-state{{#unless datapad.discovered}} dp-state-hidden{{/unless}}">
      {{#if datapad.discovered}}VISIBLE TO CREW{{else}}HIDDEN FROM CREW{{/if}}
    </span>
    <span class="dp-discover-btn" data-action="toggleDiscovered" data-member-id="{{datapad.memberId}}" data-discovered="{{datapad.discovered}}">
      {{#if datapad.discovered}}[ hide ]{{else}}[ release ]{{/if}}
    </span>
  </div>
{{/if}}

{{#each datapad.blocks}}
  {{#if this.isPlaceholder}}
    <div class="dp-block dp-secret dp-placeholder">
      <div class="dp-locked-bar">▦ ENCRYPTED — DECRYPTION REQUIRED{{#if this.lockLabel}} :: {{this.lockLabel}}{{/if}}</div>
    </div>
  {{else}}
  <div class="dp-block{{#if this.isSecret}} dp-secret{{#if this.isRevealed}} dp-revealed{{else}} dp-locked{{/if}}{{/if}}">

    {{#if this.canEdit}}
      <div class="dp-secret-bar">
        {{#if this.isSecret}}
          <span class="dp-secret-tag">{{#if this.isRevealed}}▾ DECRYPTED{{else}}▦ ENCRYPTED{{/if}}</span>
        {{else}}
          <span class="dp-block-type">{{this.type}}</span>
        {{/if}}
        <span class="dp-block-controls">
          {{#if this.isSecret}}
            <a class="dp-toggle" data-action="toggleReveal" data-collection="{{../datapad.collection}}" data-member-id="{{../datapad.memberId}}" data-block-id="{{this.blockId}}">
              {{#if this.isRevealed}}[ re-lock ]{{else}}[ reveal ]{{/if}}
            </a>
          {{/if}}
          <a class="dp-block-btn" data-action="editBlock" data-member-id="{{../datapad.memberId}}" data-block-id="{{this.blockId}}" title="Edit this block">[ edit ]</a>
          {{#unless this.isFirst}}
            <a class="dp-block-btn" data-action="moveBlock" data-member-id="{{../datapad.memberId}}" data-block-id="{{this.blockId}}" data-dir="up" title="Move up">[ ↑ ]</a>
          {{/unless}}
          {{#unless this.isLast}}
            <a class="dp-block-btn" data-action="moveBlock" data-member-id="{{../datapad.memberId}}" data-block-id="{{this.blockId}}" data-dir="down" title="Move down">[ ↓ ]</a>
          {{/unless}}
          <a class="dp-block-btn dp-block-danger" data-action="deleteBlock" data-member-id="{{../datapad.memberId}}" data-block-id="{{this.blockId}}" title="Delete this block">[ × ]</a>
        </span>
      </div>
    {{/if}}

    {{#if (eq this.type "heading")}}
      <p class="acq-label">{{this.text}}</p>

    {{else if (eq this.type "text")}}
      {{#if this.label}}<div class="dossier-block-label">{{this.label}}</div>{{/if}}
      {{#if this.body}}<p>{{this.body}}</p>{{/if}}
      {{#if this.items}}<ul class="acq-list">{{#each this.items}}<li>{{this}}</li>{{/each}}</ul>{{/if}}

    {{else if (eq this.type "keyvalue")}}
      {{#if this.label}}<div class="dossier-block-label">{{this.label}}</div>{{/if}}
      <dl class="rel-list">
        {{#each this.rows}}<dt>{{this.[0]}}</dt><dd>{{this.[1]}}</dd>{{/each}}
      </dl>

    {{else if (eq this.type "table")}}
      {{#if this.label}}<p class="acq-label">{{this.label}}</p>{{/if}}
      <table class="mission-index">
        {{#if this.headers}}<thead><tr>{{#each this.headers}}<th>{{this}}</th>{{/each}}</tr></thead>{{/if}}
        <tbody>
          {{#each this.rows}}<tr>{{#each this}}<td>{{this}}</td>{{/each}}</tr>{{/each}}
        </tbody>
      </table>

    {{else if (eq this.type "message")}}
      <div class="mission-note">
        <div class="mission-note-label">▶ {{#if this.subject}}{{this.subject}}{{else}}MESSAGE{{/if}}</div>
        <div class="msg-meta">{{#if this.from}}FROM: {{this.from}}{{/if}}{{#if this.to}} — TO: {{this.to}}{{/if}}{{#if this.date}} — {{this.date}}{{/if}}</div>
        {{#if this.body}}<p>{{this.body}}</p>{{/if}}
      </div>

    {{else}}
      <p class="term-prompt">&gt; (unknown block type: {{this.type}})</p>
    {{/if}}

  </div>
  {{/if}}
{{/each}}

{{#unless datapad.blocks.length}}
  {{#if datapad.canEdit}}
    <p class="mission-empty">— empty datapad. Use [ + add block ] to start. —</p>
  {{else}}
    <p class="mission-empty">— no data —</p>
  {{/if}}
{{/unless}}
